    "@vitejs/plugin-react-swc": "~4.0.1",
    "eslint": "~9.35.0",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-prettier": "~5.5.4",
    "eslint-plugin-react-hooks": "~5.2.0",
